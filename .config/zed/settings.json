{
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_weight": 580,
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_weight": 680,
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Tokyo Night",
    "dark": "One Dark"
  },
  "indent_guides": {
    "enabled": false
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "normal"
      },
      "keyword": {
        "font_style": "normal"
      }
    }
  },
  "disable_ai": true,
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "title_bar": {
    "show_menus": false
  }
}
