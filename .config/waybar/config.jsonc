// Global 
{
	"layer": "top",
	"position": "bottom",
	"margin": 0,
	"height": 30,
	"start_hidden": true,
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window",
		"power-profiles-daemon",
		"custom/updates",
		"backlight/slider",
		"temperature",
	],
	"modules-center": [
		"clock",
	],
	"modules-right": [
		"tray",
		"memory",
		"cpu",
		"pulseaudio",
		"pulseaudio#microphone",
		"network",
		"battery",
	],
	// Modules
	"idle_inhibitor": {
		"format": "{icon} ",
		"format-icons": {
			"activated": " ",
			"deactivated": " "
		}
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{capacity}% {icon} ",
		"format-charging": "{capacity}% 󰂄",
		"format-plugged": "{capacity}% 󱐥",
		"format-icons": [
			" ",
			" ",
			" ",
			" ",
			" "
		]
	},
	"custom/PBPbattery": {
		"exec": "~/.config/waybar/scripts/PBPbattery.sh",
		"format": "{}",
	},
	"clock": {
		"interval": 10,
		"format": " {:%H:%M} ",
		"tooltip-format": "{:%e %B %Y}"
	},
	"custom/updates": {
		"format": " {}",
		"exec": "~/.config/waybar/scripts/updates.py",
		"interval": 3600, 
		"tooltip": true
	},
	"power-profiles-daemon": {
		"format": "{icon} {profile}",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"tooltip": false,
		"format-icons": {
			"default": "💀",
			"performance": "💀",
			"balanced": "🕸",
			"power-saver": ""
		}
	},
	"cpu": {
		"interval": 5,
		"format": "  {usage}% ", // Icon: microchip
		"states": {
			"warning": 70,
			"critical": 90,
		},
		"on-click": "alacritty -e 'btm'",
	},
	"memory": {
		"interval": 5,
		"format": "  {}%", // Icon: memory
		"on-click": "alacritty -e 'btm'",
		"states": {
			"warning": 70,
			"critical": 90
		}
	},
	"network": {
		"format": " Disabled",
		"format-wifi": " {bandwidthDownBytes:>} {bandwidthUpBytes:>}",
		"tooltip-format-wifi": "{essid}",
		"format-ethernet": "  {bandwidthDownBits:>} {bandwidthUpBits:>}",
		"tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
		"format-disconnected": " no_internet",
		"on-click": "footclient -T waybar_nmtui -e nmtui",
		"interval": 2,
	},
	"hyprland/mode": {
		"format": "{}",
		"tooltip": false
	},
	"hyprland/window": {
		"format": "{}",
		"max-length": 40
	},
	"hyprland/workspaces": {
			"format": "{icon}",
			"format-icons": {
			  "1": "",
			  "2": "",
			  "3": "",
			  "4": "",
			  "5": "",
			  "default": "",
			  "active": "" 
			},
			"persistent-workspaces": {
			  "*": [ 1, 2, 3, 4, 5 ]
			}
	},
	"pulseaudio": {
		"scroll-step": 1, // %, can be a float
		"format": "{icon} {volume}%",
		"format-bluetooth": "{volume}% {icon}  {format_source}",
		"format-bluetooth-muted": "󰂲 {icon}  {format_source}",
		"format-muted": " ",
		"format-icons": {
			"hands-free": "וֹ",
			"headset": "󰋋",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				""
			]
		},
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
		"on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
	},
	"pulseaudio#microphone": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": " ",
		"on-click": "pamixer --default-source -t",
		"on-click-right": "pavucontrol",
		"on-scroll-up": "pamixer --default-source -i 5",
		"on-scroll-down": "pamixer --default-source -d 5",
		"scroll-step": 5
	},
	"custom/weather": {
		"exec": "~/.config/waybar/scripts/weather.sh tampa",
		"return-type": "json",
		"interval": 600,
	},
	"tray": {
		"icon-size": 17,
		"spacing": 10,
	},
	"custom/terminal": {
		"format": " ",
		"on-click": "exec kitty",
		"tooltip": false
	},
	"custom/media": {
		"format": "{icon} {text}",
		"return-type": "json",
		"max-length": 40,
		"format-icons": {
			"spotify": " ",
			"default": "󰗃 "
		},
		"escape": true,
		"exec": "/usr/bin/python3 $HOME/.config/waybar/scripts/mediaplayer.py 2> /dev/null"
	},
	"backlight/slider": {
		"min": 0,
		"max": 100,
		"orientation": "horizontal",
		"device": "intel_backlight"
	},
}
